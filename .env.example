# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM / embeddings ---
OPENAI_API_KEY=your_openai_key

# --- Web search fallback ---
# Tavily requires a key. Leave blank to fall back to duckduckgo-search (free, no key).
TAVILY_API_KEY=your_tavily_key

# --- Optional overrides (defaults shown) ---
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_BACKEND=openai        # "openai" (text-embedding-3-small) or "local" (all-MiniLM-L6-v2)
# CONFIDENCE_THRESHOLD=0.55
# REWRITE_TIMEOUT_S=5     # query rewriter budget; on timeout the original query is used
# LLM_TIMEOUT_S=60        # answer generation timeout per attempt
# DOCS_DIR=docs
# CHROMA_DIR=.chroma
